<Window x:Class="SG.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SG" Width="1100" Height="700" MinWidth="800" MinHeight="500" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="14">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><TextBox x:Name="FilterBox" Width="260" Height="30" VerticalContentAlignment="Center" Margin="0,0,6,0"/><Button Content="새로고침" Click="Refresh_Click"/><Button Content="선택 항목 새로고침" Click="RefreshSelected_Click"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="10"/><Button Content="정상 종료 요청" Click="Close_Click"/></StackPanel>
  </Grid>
  <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="StatusText" Text="준비"/></StatusBar>
  <DataGrid x:Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="프로세스" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="창 제목" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="메모리" Binding="{Binding Memory}" Width="110"/><DataGridTextColumn Header="아키텍처" Binding="{Binding Architecture}" Width="100"/><DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="100"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>